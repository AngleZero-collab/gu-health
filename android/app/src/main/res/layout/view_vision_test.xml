<com.gucare.health.ObservationLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="16dp" android:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/vision_instruction" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:textAppearance="@style/CareHeading" android:textSize="24sp" />
        <com.gucare.health.ObservationGridView android:id="@+id/observation_grid" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:layout_marginVertical="12dp" android:contentDescription="@string/grid_description" />
    </LinearLayout>
    <LinearLayout android:id="@+id/vision_answers" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:paddingTop="8dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/vision_clear" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:minHeight="80dp" android:text="@string/vision_clear" android:textSize="24sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/vision_changed" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
            android:minHeight="80dp" android:layout_marginTop="16dp" android:text="@string/vision_changed" android:textSize="24sp" app:backgroundTint="@color/alert_orange" android:textColor="@color/white" />
    </LinearLayout>
</com.gucare.health.ObservationLayout>
