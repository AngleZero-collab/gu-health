<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:paddingHorizontal="20dp" android:paddingTop="20dp" android:paddingBottom="116dp">
            <TextView android:id="@+id/mascot_greeting" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textAppearance="@style/CareHeading" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/dark_green" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screening_note" android:textAppearance="@style/CareBody" />
            <com.google.android.material.button.MaterialButton android:id="@+id/change_profile" style="@style/CareButton.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/change_profile" />
            <TextView android:id="@+id/home_empty" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="20dp" android:textAppearance="@style/CareBody" android:visibility="gone" />
            <androidx.recyclerview.widget.RecyclerView android:id="@+id/screening_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:nestedScrollingEnabled="false" android:importantForAccessibility="yes" />
            <com.google.android.material.button.MaterialButton android:id="@+id/home_observe" style="@style/CareButton.Secondary"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/start_observation" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:text="@string/voice_hint" android:textAppearance="@style/CareBody" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.floatingactionbutton.FloatingActionButton android:id="@+id/fab_ai_voice"
        android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="bottom|end" android:layout_margin="20dp"
        android:contentDescription="@string/open_voice" app:srcCompat="@drawable/ic_microphone" app:backgroundTint="@color/dark_green"
        app:tint="@color/white" app:fabCustomSize="72dp" app:maxImageSize="32dp" app:ensureMinTouchTargetSize="true" />
</FrameLayout>
